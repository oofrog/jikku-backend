# 데이터베이스 (PostgreSQL 예시)
DB_URL=DBurl
DB_USERNAME=username
DB_PASSWORD=password

# TourAPI
TOUR_API_MOBILE_APP=jikku
TOUR_API_SERVICE_KEY=여기에_발급받은_서비스키

# JWT (HS256 서명키 — 반드시 32자 이상, 팀 채널에서 공유)
JWT_SECRET=여기에_32자이상의_랜덤문자열

# 개발용 로그인(POST /auth/dev-login) 보호키. X-Dev-Key 헤더로 보낸다.
# 비워두면 dev-login이 항상 거부되므로, 로컬에서 쓰려면 반드시 채운다.
DEV_LOGIN_KEY=여기에_랜덤문자열

# Cloudflare R2 (이미지 저장). 키는 절대 프론트로 넘기지 않는다
R2_ACCOUNT_ID=클라우드플레어_계정ID
R2_ACCESS_KEY_ID=R2_API_토큰_액세스키
R2_SECRET_ACCESS_KEY=R2_API_토큰_시크릿키
R2_BUCKET=버킷명
# 공개 읽기 주소. r2.dev 도메인 또는 연결한 커스텀 도메인 (끝에 / 없이)
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev